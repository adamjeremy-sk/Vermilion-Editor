{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (local)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git -* push*": "deny",
      "git commit*": "deny",
      "git -* commit*": "deny",
      "git cherry-pick*": "deny",
      "git -* cherry-pick*": "deny",
      "git merge*": "deny",
      "git -* merge*": "deny",
      "git rebase*": "deny",
      "git -* rebase*": "deny",
      "git revert*": "deny",
      "git -* revert*": "deny",
      "git am*": "deny",
      "git -* am*": "deny",
      "git checkout*": "deny",
      "git -* checkout*": "deny",
      "git switch*": "deny",
      "git -* switch*": "deny",
      "git restore*": "deny",
      "git -* restore*": "deny",
      "git reset*": "deny",
      "git -* reset*": "deny",
      "git clean*": "deny",
      "git -* clean*": "deny",
      "git stash*": "deny",
      "git -* stash*": "deny",
      "git update-ref*": "deny",
      "git -* update-ref*": "deny"
    }
  }
}
